# Export these settings explicitly; .env files are not loaded automatically.
ANTHROPIC_API_KEY=
# Set an available Anthropic model explicitly when running live queries.
ANTHROPIC_MODEL=
CLOUDNOVA_AS_OF_DATE=2026-11-21
CLOUDNOVA_DATA_PATH=data/cloudnova_invoices.csv
CLOUDNOVA_DB_PATH=build/cloudnova.duckdb
CLOUDNOVA_QUERY_TIMEOUT=5
CLOUDNOVA_MODEL_TIMEOUT=30
CLOUDNOVA_MODEL_RETRIES=2
